/* OrionPlayer — Professional VLC-Grade Desktop Dark Theme */

QMainWindow {
    background-color: #12151c;
    color: #e6edf3;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
    color: #c9d1d9;
    font-size: 13px;
}

/* ================= Professional Menubar ================= */
QMenuBar {
    background-color: #161b22;
    color: #c9d1d9;
    border-bottom: 1px solid #30363d;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #21262d;
    color: #58a6ff;
}

QMenu {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 4px 6px;
}

/* ================= Bottom VLC Toolbar ================= */
#OrionVlcToolbar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
}

#OrionVlcElapsedLabel, #OrionVlcDurationLabel {
    color: #8b949e;
    font-family: monospace;
    font-size: 11px;
    font-weight: bold;
    padding: 0 4px;
}

/* Time Slider */
QSlider#OrionVlcTimeSlider::groove:horizontal {
    height: 6px;
    background: #1c222d;
    border-radius: 3px;
}

QSlider#OrionVlcTimeSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e3a8a, stop:0.5 #2563eb, stop:1 #00f5ff);
    border-radius: 3px;
}

QSlider#OrionVlcTimeSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #00f5ff;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#OrionVlcTimeSlider::handle:horizontal:hover {
    background: #00f5ff;
    border: 2px solid #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 5px;
    color: #c9d1d9;
    padding: 4px 8px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #00f5ff;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton#OrionVlcPlayPauseBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e3a8a, stop:0.5 #2563eb, stop:1 #00d2ff);
    border: 1px solid #00f5ff;
    border-radius: 6px;
    padding: 2px;
}

QPushButton#OrionVlcPlayPauseBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2563eb, stop:0.5 #3b82f6, stop:1 #00f5ff);
    border: 1px solid #ffffff;
}

QPushButton#OrionVlcPlayPauseBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1e3a8a, stop:1 #1d4ed8);
}

QPushButton#OrionVlcToolBtn {
    background: #1c222d;
    border: 1px solid #2e3846;
    border-radius: 6px;
    padding: 3px;
}

QPushButton#OrionVlcToolBtn:hover {
    background: #252e3d;
    border-color: #00d2ff;
}

QPushButton#OrionVlcToolBtn:pressed {
    background: #141820;
    border-color: #0077b6;
}

QPushButton#OrionVlcMuteBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 2px;
}

QPushButton#OrionVlcMuteBtn:hover {
    background: #21262d;
    border-color: #30363d;
}

#OrionVlcAdvancedBar QPushButton {
    background: #1a202c;
    border: 1px solid #2d3748;
    border-radius: 5px;
    padding: 2px 8px;
    color: #cbd5e1;
    font-size: 11px;
}

#OrionVlcAdvancedBar QPushButton:hover {
    background: #2d3748;
    border-color: #00f5ff;
    color: #ffffff;
}

#OrionVlcAdvancedBar QPushButton:pressed {
    background: #11151c;
}

/* Volume Slider */
QSlider#OrionVlcVolSlider::groove:horizontal {
    height: 4px;
    background: #21262d;
    border-radius: 2px;
}

QSlider#OrionVlcVolSlider::sub-page:horizontal {
    background: #58a6ff;
    border-radius: 2px;
}

QSlider#OrionVlcVolSlider::handle:horizontal {
    background: #e6edf3;
    border: 1px solid #58a6ff;
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

#OrionVlcVolLabel {
    color: #8b949e;
    font-family: monospace;
    font-size: 11px;
}

/* ================= Status Bar ================= */
QStatusBar {
    background-color: #161b22;
    border-top: 1px solid #21262d;
    color: #8b949e;
    font-size: 11px;
}

/* ================= Playlist & Library View ================= */
#OrionPlaylistView {
    background-color: #0d1117;
}

QTreeWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    padding: 4px;
}

QTreeWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QTableWidget {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    gridline-color: #21262d;
    color: #c9d1d9;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    font-weight: bold;
    border: 1px solid #21262d;
    padding: 5px;
}

/* ================= Dialogs, Tabs & Controls ================= */
QDialog {
    background-color: #161b22;
    color: #e6edf3;
}

QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 6px;
    background-color: #161b22;
}

QTabBar::tab {
    background-color: #21262d;
    color: #8b949e;
    padding: 7px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    font-weight: bold;
    border: 1px solid #30363d;
    border-bottom: none;
}

QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #8b949e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f0f6fc;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #58a6ff;
}

QToolTip {
    background-color: #1c2128;
    color: #f0f6fc;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
