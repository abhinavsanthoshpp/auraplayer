/* OrionPlayer — High-Performance Studio Dark Theme
 * Engineered for professional Linux & cross-platform workstations.
 */

QMainWindow {
    background-color: #0d1017;
    color: #f1f5f9;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
    color: #cbd5e1;
    font-size: 13px;
}

/* ================= Professional Menubar ================= */
QMenuBar {
    background-color: #131620;
    color: #cbd5e1;
    border-bottom: 1px solid #222634;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e2330;
    color: #f1f5f9;
}

QMenu {
    background-color: #181c26;
    color: #f1f5f9;
    border: 1px solid #282e3e;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #282e3e;
    margin: 4px 6px;
}

/* ================= Bottom Master Toolbar ================= */
#OrionVlcToolbar {
    background-color: #131620;
    border-top: 1px solid #222634;
}

#OrionVlcElapsedLabel, #OrionVlcDurationLabel {
    color: #94a3b8;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 0 4px;
}

#OrionVlcDurationLabel:hover {
    color: #f1f5f9;
}

/* Time Scrubber Slider */
QSlider#OrionVlcTimeSlider::groove:horizontal {
    height: 4px;
    background: #232838;
    border-radius: 2px;
}

QSlider#OrionVlcTimeSlider::sub-page:horizontal {
    background: #2563eb;
    border-radius: 2px;
}

QSlider#OrionVlcTimeSlider::handle:horizontal {
    background: #f1f5f9;
    border: 1px solid #2563eb;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider#OrionVlcTimeSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #3b82f6;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* Base PushButton */
QPushButton {
    background-color: #1a1e28;
    border: 1px solid #282e3e;
    border-radius: 5px;
    color: #cbd5e1;
    padding: 4px 10px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #242938;
    border-color: #384156;
    color: #f8fafc;
}

QPushButton:pressed {
    background-color: #141720;
    border-color: #222634;
}

/* Centerpiece Play / Pause Button */
QPushButton#OrionVlcPlayPauseBtn {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    border-radius: 6px;
    padding: 2px;
}

QPushButton#OrionVlcPlayPauseBtn:hover {
    background-color: #3b82f6;
    border-color: #60a5fa;
}

QPushButton#OrionVlcPlayPauseBtn:pressed {
    background-color: #1d4ed8;
    border-color: #2563eb;
}

/* Professional Ghost / Flat Tool Buttons */
QPushButton#OrionVlcToolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px;
}

QPushButton#OrionVlcToolBtn:hover {
    background-color: #1e2330;
    border-color: #2c3345;
}

QPushButton#OrionVlcToolBtn:pressed {
    background-color: #161922;
    border-color: #222736;
}

/* Mute Button */
QPushButton#OrionVlcMuteBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 2px;
}

QPushButton#OrionVlcMuteBtn:hover {
    background-color: #1e2330;
    border-color: #2c3345;
}

/* Advanced Recording / Inspection Bar */
#OrionVlcAdvancedBar QPushButton {
    background-color: #181c26;
    border: 1px solid #282e3e;
    border-radius: 4px;
    padding: 2px 8px;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
}

#OrionVlcAdvancedBar QPushButton:hover {
    background-color: #222736;
    border-color: #384156;
    color: #f1f5f9;
}

#OrionVlcAdvancedBar QPushButton:pressed {
    background-color: #13151e;
}

/* Volume Slider */
QSlider#OrionVlcVolSlider::groove:horizontal {
    height: 3px;
    background: #232838;
    border-radius: 1.5px;
}

QSlider#OrionVlcVolSlider::sub-page:horizontal {
    background: #64748b;
    border-radius: 1.5px;
}

QSlider#OrionVlcVolSlider::sub-page:horizontal:hover {
    background: #3b82f6;
}

QSlider#OrionVlcVolSlider::handle:horizontal {
    background: #cbd5e1;
    border: none;
    width: 10px;
    height: 10px;
    margin: -3.5px 0;
    border-radius: 5px;
}

QSlider#OrionVlcVolSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 1px solid #3b82f6;
}

#OrionVlcVolLabel {
    color: #94a3b8;
    font-family: "JetBrains Mono", "SF Mono", monospace;
    font-size: 11px;
    font-weight: 600;
}

/* ================= Status Bar ================= */
QStatusBar {
    background-color: #131620;
    border-top: 1px solid #1e222e;
    color: #64748b;
    font-size: 11px;
}

/* ================= Playlist & Library View ================= */
#OrionPlaylistView {
    background-color: #0a0d14;
}

QTreeWidget {
    background-color: #131620;
    border: 1px solid #232838;
    border-radius: 6px;
    color: #cbd5e1;
    padding: 4px;
}

QTreeWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeWidget::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QTableWidget {
    background-color: #0d1017;
    border: 1px solid #232838;
    border-radius: 6px;
    gridline-color: #1e222e;
    color: #cbd5e1;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #131620;
    color: #94a3b8;
    font-weight: 600;
    border: 1px solid #1e222e;
    padding: 5px;
}

/* ================= Dialogs, Tabs & Controls ================= */
QDialog {
    background-color: #131620;
    color: #f1f5f9;
}

QTabWidget::pane {
    border: 1px solid #282e3e;
    border-radius: 6px;
    background-color: #131620;
}

QTabBar::tab {
    background-color: #1a1e28;
    color: #94a3b8;
    padding: 7px 14px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #131620;
    color: #f1f5f9;
    font-weight: 600;
    border: 1px solid #282e3e;
    border-bottom: none;
}

QGroupBox {
    border: 1px solid #282e3e;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
    color: #94a3b8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1a1e28;
    border: 1px solid #282e3e;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f1f5f9;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3b82f6;
}

QToolTip {
    background-color: #181c26;
    color: #f1f5f9;
    border: 1px solid #2c3345;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
