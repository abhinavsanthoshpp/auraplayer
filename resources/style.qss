/* AuraPlayer — Professional VLC-Grade Desktop Dark Theme */

QMainWindow {
    background-color: #12151c;
    color: #e6edf3;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
    color: #c9d1d9;
    font-size: 13px;
}

/* ================= Professional Menubar ================= */
QMenuBar {
    background-color: #161b22;
    color: #c9d1d9;
    border-bottom: 1px solid #30363d;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #21262d;
    color: #58a6ff;
}

QMenu {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 4px 6px;
}

/* ================= Bottom VLC Toolbar ================= */
#AuraVlcToolbar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
}

#AuraVlcElapsedLabel, #AuraVlcDurationLabel {
    color: #8b949e;
    font-family: monospace;
    font-size: 11px;
    font-weight: bold;
    padding: 0 4px;
}

/* Time Slider */
QSlider#AuraVlcTimeSlider::groove:horizontal {
    height: 6px;
    background: #21262d;
    border-radius: 3px;
}

QSlider#AuraVlcTimeSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1f6feb, stop:1 #ff7b00);
    border-radius: 3px;
}

QSlider#AuraVlcTimeSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #ff7b00;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#AuraVlcTimeSlider::handle:horizontal:hover {
    background: #ff7b00;
    border: 2px solid #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 5px;
    color: #c9d1d9;
    padding: 4px 8px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #58a6ff;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton#AuraVlcPlayPauseBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1f6feb, stop:1 #00b4d8);
    border: 1px solid #58a6ff;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#AuraVlcPlayPauseBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #388bfd, stop:1 #48cae4);
}

QPushButton#AuraVlcToolBtn {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    font-size: 12px;
}

QPushButton#AuraVlcToolBtn:hover {
    background: #30363d;
    border-color: #58a6ff;
}

QPushButton#AuraVlcMuteBtn {
    background: transparent;
    border: none;
    font-size: 13px;
}

/* Volume Slider */
QSlider#AuraVlcVolSlider::groove:horizontal {
    height: 4px;
    background: #21262d;
    border-radius: 2px;
}

QSlider#AuraVlcVolSlider::sub-page:horizontal {
    background: #58a6ff;
    border-radius: 2px;
}

QSlider#AuraVlcVolSlider::handle:horizontal {
    background: #e6edf3;
    border: 1px solid #58a6ff;
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

#AuraVlcVolLabel {
    color: #8b949e;
    font-family: monospace;
    font-size: 11px;
}

/* ================= Status Bar ================= */
QStatusBar {
    background-color: #161b22;
    border-top: 1px solid #21262d;
    color: #8b949e;
    font-size: 11px;
}

/* ================= Playlist & Library View ================= */
#AuraPlaylistView {
    background-color: #0d1117;
}

QTreeWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    padding: 4px;
}

QTreeWidget::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QTableWidget {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    gridline-color: #21262d;
    color: #c9d1d9;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    font-weight: bold;
    border: 1px solid #21262d;
    padding: 5px;
}

/* ================= Dialogs, Tabs & Controls ================= */
QDialog {
    background-color: #161b22;
    color: #e6edf3;
}

QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 6px;
    background-color: #161b22;
}

QTabBar::tab {
    background-color: #21262d;
    color: #8b949e;
    padding: 7px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    font-weight: bold;
    border: 1px solid #30363d;
    border-bottom: none;
}

QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #8b949e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f0f6fc;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #58a6ff;
}

QToolTip {
    background-color: #1c2128;
    color: #f0f6fc;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
