/* AuraPlayer — "Dynamic Nebula" Next-Gen Cinema UI Theme */

QMainWindow {
    background-color: #07090e;
    color: #f0f6fc;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
    color: #e6edf3;
    font-size: 13px;
}

/* ================= Top Aura Floating Capsule ================= */
#AuraTopCapsule {
    background: rgba(14, 18, 28, 0.90);
    border: 1px solid rgba(0, 240, 255, 0.25);
    border-radius: 23px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
}

#AuraCapsuleBrand {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding-left: 6px;
}

#AuraCapsuleBrand strong {
    color: #00f0ff;
}

QPushButton#AuraCapsuleBtn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d0d7de;
    border-radius: 14px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#AuraCapsuleBtn:hover {
    background: rgba(0, 240, 255, 0.18);
    border-color: #00f0ff;
    color: #ffffff;
}

QPushButton#AuraCapsuleIconBtn {
    background: transparent;
    border: none;
    color: #8b949e;
    font-size: 14px;
    border-radius: 12px;
    padding: 2px;
}

QPushButton#AuraCapsuleIconBtn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #00f0ff;
}

QPushButton#AuraCapsuleCloseBtn {
    background: rgba(255, 95, 86, 0.15);
    border: 1px solid rgba(255, 95, 86, 0.3);
    color: #ff5f56;
    border-radius: 12px;
    font-weight: bold;
    padding: 2px 8px;
}

QPushButton#AuraCapsuleCloseBtn:hover {
    background: #ff5f56;
    color: #ffffff;
}

/* ================= Bottom Floating Cyber Deck ================= */
#AuraCyberDeck {
    background: rgba(12, 16, 26, 0.94);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 26px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 240, 255, 0.12);
}

/* Holographic Timeline */
QSlider#AuraHoloTimeline::groove:horizontal {
    height: 5px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
}

QSlider#AuraHoloTimeline::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1f6feb, stop:1 #00f0ff);
    border-radius: 2px;
}

QSlider#AuraHoloTimeline::handle:horizontal {
    background: #ffffff;
    border: 2px solid #00f0ff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider#AuraHoloTimeline::handle:horizontal:hover {
    background: #00f0ff;
    border: 2px solid #ffffff;
}

#AuraTimeBadge {
    color: #8b949e;
    font-size: 11px;
    font-family: monospace;
    font-weight: bold;
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 8px;
    border-radius: 10px;
}

/* Central Aura Play Core */
QPushButton#AuraPlayCore {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00e5ff, stop:1 #1f6feb);
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 24px;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#AuraPlayCore:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #33f0ff, stop:1 #388bfd);
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.6);
}

QPushButton#AuraNavBtn {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    color: #c9d1d9;
    font-size: 12px;
}

QPushButton#AuraNavBtn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

QPushButton#AuraStepBtn {
    background: transparent;
    border: none;
    color: #8b949e;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#AuraStepBtn:hover {
    color: #00f0ff;
}

/* Sound Capsule */
#AuraSoundCapsule {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QPushButton#AuraMutePill {
    background: transparent;
    border: none;
    font-size: 13px;
}

QSlider#AuraFluidVolSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
}

QSlider#AuraFluidVolSlider::sub-page:horizontal {
    background: #00f0ff;
    border-radius: 2px;
}

QSlider#AuraFluidVolSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #00f0ff;
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

#AuraVolBadge {
    color: #00f0ff;
    font-size: 11px;
    font-family: monospace;
    font-weight: bold;
}

/* Pill Combos & Studio Buttons */
QComboBox#AuraPillCombo {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 4px 8px;
    color: #c9d1d9;
    font-size: 11px;
    font-weight: 600;
}

QComboBox#AuraPillCombo:hover {
    border-color: #00f0ff;
    color: #ffffff;
}

QComboBox#AuraPillCombo::drop-down {
    border: none;
    width: 14px;
}

QPushButton#AuraStudioLaunchPill {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(31, 111, 235, 0.4), stop:1 rgba(0, 240, 255, 0.4));
    border: 1px solid #00f0ff;
    border-radius: 16px;
    color: #ffffff;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#AuraStudioLaunchPill:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1f6feb, stop:1 #00f0ff);
}

QPushButton#AuraUtilityPill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    color: #8b949e;
}

QPushButton#AuraUtilityPill:hover {
    border-color: #00f0ff;
    color: #ffffff;
}

/* ================= Side Aura Studio Drawer ================= */
#AuraStudioDrawer {
    background: rgba(10, 14, 22, 0.96);
    border-left: 1px solid rgba(0, 240, 255, 0.25);
}

#AuraStudioHeaderTitle {
    font-size: 15px;
    color: #ffffff;
}

#AuraStudioHeaderTitle strong {
    color: #00f0ff;
}

QPushButton#AuraStudioCloseBtn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    color: #8b949e;
    font-size: 12px;
}

QPushButton#AuraStudioCloseBtn:hover {
    background: rgba(255, 95, 86, 0.2);
    color: #ff5f56;
}

QTabWidget#AuraStudioTabs::pane {
    border: none;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #8b949e;
    padding: 6px 10px;
    margin-right: 4px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: rgba(0, 240, 255, 0.18);
    border-color: #00f0ff;
    color: #ffffff;
}

QLineEdit#AuraStudioSearch {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 6px 12px;
    color: #ffffff;
    font-size: 12px;
}

QListWidget#AuraStudioQueueList {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 4px;
}

QListWidget#AuraStudioQueueList::item {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 4px;
    color: #d0d7de;
}

QListWidget#AuraStudioQueueList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(31, 111, 235, 0.6), stop:1 rgba(0, 240, 255, 0.4));
    color: #ffffff;
}

QPushButton#AuraPresetPill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 600;
    color: #8b949e;
}

QPushButton#AuraPresetPill:hover {
    background: rgba(0, 240, 255, 0.2);
    border-color: #00f0ff;
    color: #ffffff;
}

/* Dynamic OSD Toast */
#AuraDynamicOsd {
    background: rgba(14, 18, 28, 0.94);
    color: #00f0ff;
    font-size: 15px;
    font-weight: bold;
    border: 1px solid rgba(0, 240, 255, 0.35);
    border-radius: 20px;
    padding: 8px 22px;
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.3);
}
