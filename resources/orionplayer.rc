#include <windows.h>

IDI_ICON1 ICON "icons/orionplayer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Abhinav Santhosh\0"
            VALUE "FileDescription",  "Orion Player — VLC-Grade High-Performance Media Player\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "orionplayer\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Abhinav Santhosh. All Rights Reserved.\0"
            VALUE "OriginalFilename", "orionplayer.exe\0"
            VALUE "ProductName",      "Orion Player\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
